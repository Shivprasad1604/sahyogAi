# Copy this file to .env and fill in what you have.
# EVERY line is optional — the app starts and all financial numbers work with none of them.

# Database. Omit entirely to use a local SQLite file (./sahyogai.db).
# DATABASE_URL=mysql+pymysql://root:password@localhost:3306/sahyogai

# Claude API key. Without it, routing falls back to keyword rules and
# narration falls back to a deterministic formatter. Numbers are identical.
# ANTHROPIC_API_KEY=sk-ant-...

# Model used for routing and narration.
ANTHROPIC_MODEL=claude-sonnet-4-5

# Where ChromaDB persists. Without chromadb installed, scheme prose is skipped.
CHROMA_DIR=./chroma_store

# Twilio, for the WhatsApp channel only.
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
